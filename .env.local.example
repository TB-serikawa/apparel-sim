# Copy this file to .env.local and fill in values before running locally.

# URL of the export API (AWS Lambda via API Gateway)
NEXT_PUBLIC_EXPORT_API_URL=https://your-api-gateway-url.execute-api.ap-northeast-1.amazonaws.com/prod

# Optional: override export API URL for local Lambda dev (e.g. via SAM CLI)
# NEXT_PUBLIC_EXPORT_API_URL=http://localhost:3001
